<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:padding="@dimen/spacing">

  <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/head_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="@dimen/spacing"
    app:layout_constraintTop_toTopOf="parent">

    <TextView
      android:id="@+id/score_message"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textSize="@dimen/score_text_size"
      android:text="Score\n0"
      android:gravity="center_horizontal"
      android:textStyle="bold"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent"/>

  </androidx.constraintlayout.widget.ConstraintLayout>

  <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/letters_holder"
    android:layout_width="0dp"
    android:layout_height="0dp"
    app:layout_constraintTop_toBottomOf="@id/head_holder"
    app:layout_constraintBottom_toTopOf="@id/keyboard"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintDimensionRatio="5:6">

    <TextView
      style="@style/letters_slot"
      android:id="@+id/letter_0_0"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toStartOf="@id/letter_0_1"
      app:layout_constraintDimensionRatio="1:1"/>

    <TextView
      style="@style/letters_slot"
      android:id="@+id/letter_0_1"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintStart_toEndOf="@id/letter_0_0"
      app:layout_constraintEnd_toStartOf="@id/letter_0_2"
      app:layout_constraintDimensionRatio="1:1"/>

    <TextView
      style="@style/letters_slot"
      android:id="@+id/letter_0_2"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintStart_toEndOf="@id/letter_0_1"
      app:layout_constraintEnd_toStartOf="@id/letter_0_3"
      app:layout_constraintDimensionRatio="1:1"/>


    <TextView
      style="@style/letters_slot"
      android:id="@+id/letter_0_3"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintStart_toEndOf="@id/letter_0_2"
      app:layout_constraintEnd_toStartOf="@id/letter_0_4"
      app:layout_constraintDimensionRatio="1:1"/>

    <TextView
      style="@style/letters_slot"
      android:id="@+id/letter_0_4"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintStart_toEndOf="@id/letter_0_3"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintDimensionRatio="1:1"/>

    <TextView
      style="@style/letters_slot"
      android:id="@+id/letter_1_0"
      app:layout_constraintTop_toBottomOf="@id/letter_0_0"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toStartOf="@id/letter_0_1"
      app:layout_constraintDimensionRatio="1:1"/>

    <TextView
      style="@style/letters_slot"
      android:id="@+id/letter_1_1"
      app:layout_constraintTop_toBottomOf="@id/letter_0_1"
      app:layout_constraintStart_toEndOf="@id/letter_1_0"
      app:layout_constraintEnd_toStartOf="@id/letter_1_2"
      app:layout_constraintDimensionRatio="1:1"/>

    <TextView
      style="@style/letters_slot"
      android:id="@+id/letter_1_2"
      app:layout_constraintTop_toBottomOf="@id/letter_0_2"
      app:layout_constraintStart_toEndOf="@id/letter_1_1"
      app:layout_constraintEnd_toStartOf="@id/letter_1_3"
      app:layout_constraintDimensionRatio="1:1"/>

    <TextView
      style="@style/letters_slot"
      android:id="@+id/letter_1_3"
      app:layout_constraintTop_toBottomOf="@id/letter_0_3"
      app:layout_constraintStart_toEndOf="@id/letter_1_2"
      app:layout_constraintEnd_toStartOf="@id/letter_1_4"
      app:layout_constraintDimensionRatio="1:1"/>

    <TextView
      style="@style/letters_slot"
      android:id="@+id/letter_1_4"
      app:layout_constraintTop_toBottomOf="@id/letter_0_4"
      app:layout_constraintStart_toEndOf="@id/letter_1_3"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintDimensionRatio="1:1"/>

    <TextView
      style="@style/letters_slot"
      android:id="@+id/letter_2_0"
      app:layout_constraintTop_toBottomOf="@id/letter_1_0"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toStartOf="@id/letter_2_1"
      app:layout_constraintDimensionRatio="1:1"/>

    <TextView
      style="@style/letters_slot"
      android:id="@+id/letter_2_1"
      app:layout_constraintTop_toBottomOf="@id/letter_1_1"
      app:layout_constraintStart_toEndOf="@id/letter_2_0"
      app:layout_constraintEnd_toStartOf="@id/letter_2_2"
      app:layout_constraintDimensionRatio="1:1"/>

    <TextView
      style="@style/letters_slot"
      android:id="@+id/letter_2_2"
      app:layout_constraintTop_toBottomOf="@id/letter_1_2"
      app:layout_constraintStart_toEndOf="@id/letter_2_1"
      app:layout_constraintEnd_toStartOf="@id/letter_2_3"
      app:layout_constraintDimensionRatio="1:1"/>


    <TextView
      style="@style/letters_slot"
      android:id="@+id/letter_2_3"
      app:layout_constraintTop_toBottomOf="@id/letter_1_3"
      app:layout_constraintStart_toEndOf="@id/letter_2_2"
      app:layout_constraintEnd_toStartOf="@id/letter_2_4"
      app:layout_constraintDimensionRatio="1:1"/>

    <TextView
      style="@style/letters_slot"
      android:id="@+id/letter_2_4"
      app:layout_constraintTop_toBottomOf="@id/letter_1_4"
      app:layout_constraintStart_toEndOf="@id/letter_2_3"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintDimensionRatio="1:1"/>

    <TextView
      style="@style/letters_slot"
      android:id="@+id/letter_3_0"
      app:layout_constraintTop_toBottomOf="@id/letter_2_0"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toStartOf="@id/letter_3_1"
      app:layout_constraintDimensionRatio="1:1"/>

    <TextView
      style="@style/letters_slot"
      android:id="@+id/letter_3_1"
      app:layout_constraintTop_toBottomOf="@id/letter_2_1"
      app:layout_constraintStart_toEndOf="@id/letter_3_0"
      app:layout_constraintEnd_toStartOf="@id/letter_3_2"
      app:layout_constraintDimensionRatio="1:1"/>

    <TextView
      style="@style/letters_slot"
      android:id="@+id/letter_3_2"
      app:layout_constraintTop_toBottomOf="@id/letter_2_2"
      app:layout_constraintStart_toEndOf="@id/letter_3_1"
      app:layout_constraintEnd_toStartOf="@id/letter_3_3"
      app:layout_constraintDimensionRatio="1:1"/>


    <TextView
      style="@style/letters_slot"
      android:id="@+id/letter_3_3"
      app:layout_constraintTop_toBottomOf="@id/letter_2_3"
      app:layout_constraintStart_toEndOf="@id/letter_3_2"
      app:layout_constraintEnd_toStartOf="@id/letter_3_4"
      app:layout_constraintDimensionRatio="1:1"/>

    <TextView
      style="@style/letters_slot"
      android:id="@+id/letter_3_4"
      app:layout_constraintTop_toBottomOf="@id/letter_2_4"
      app:layout_constraintStart_toEndOf="@id/letter_3_3"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintDimensionRatio="1:1"/>

    <TextView
      style="@style/letters_slot"
      android:id="@+id/letter_4_0"
      app:layout_constraintTop_toBottomOf="@id/letter_3_0"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toStartOf="@id/letter_4_1"
      app:layout_constraintDimensionRatio="1:1"/>

    <TextView
      style="@style/letters_slot"
      android:id="@+id/letter_4_1"
      app:layout_constraintTop_toBottomOf="@id/letter_3_1"
      app:layout_constraintStart_toEndOf="@id/letter_4_0"
      app:layout_constraintEnd_toStartOf="@id/letter_4_2"
      app:layout_constraintDimensionRatio="1:1"/>

    <TextView
      style="@style/letters_slot"
      android:id="@+id/letter_4_2"
      app:layout_constraintTop_toBottomOf="@id/letter_3_2"
      app:layout_constraintStart_toEndOf="@id/letter_4_1"
      app:layout_constraintEnd_toStartOf="@id/letter_4_3"
      app:layout_constraintDimensionRatio="1:1"/>


    <TextView
      style="@style/letters_slot"
      android:id="@+id/letter_4_3"
      app:layout_constraintTop_toBottomOf="@id/letter_3_3"
      app:layout_constraintStart_toEndOf="@id/letter_4_2"
      app:layout_constraintEnd_toStartOf="@id/letter_4_4"
      app:layout_constraintDimensionRatio="1:1"/>

    <TextView
      style="@style/letters_slot"
      android:id="@+id/letter_4_4"
      app:layout_constraintTop_toBottomOf="@id/letter_3_4"
      app:layout_constraintStart_toEndOf="@id/letter_4_3"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintDimensionRatio="1:1"/>

    <TextView
      style="@style/letters_slot"
      android:id="@+id/letter_5_0"
      app:layout_constraintTop_toBottomOf="@id/letter_4_0"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toStartOf="@id/letter_5_1"
      app:layout_constraintDimensionRatio="1:1"/>

    <TextView
      style="@style/letters_slot"
      android:id="@+id/letter_5_1"
      app:layout_constraintTop_toBottomOf="@id/letter_4_1"
      app:layout_constraintStart_toEndOf="@id/letter_5_0"
      app:layout_constraintEnd_toStartOf="@id/letter_5_2"
      app:layout_constraintDimensionRatio="1:1"/>

    <TextView
      style="@style/letters_slot"
      android:id="@+id/letter_5_2"
      app:layout_constraintTop_toBottomOf="@id/letter_4_2"
      app:layout_constraintStart_toEndOf="@id/letter_5_1"
      app:layout_constraintEnd_toStartOf="@id/letter_5_3"
      app:layout_constraintDimensionRatio="1:1"/>

    <TextView
      style="@style/letters_slot"
      android:id="@+id/letter_5_3"
      app:layout_constraintTop_toBottomOf="@id/letter_4_3"
      app:layout_constraintStart_toEndOf="@id/letter_5_2"
      app:layout_constraintEnd_toStartOf="@id/letter_5_4"
      app:layout_constraintDimensionRatio="1:1"/>

    <TextView
      style="@style/letters_slot"
      android:id="@+id/letter_5_4"
      app:layout_constraintTop_toBottomOf="@id/letter_4_4"
      app:layout_constraintStart_toEndOf="@id/letter_5_3"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintDimensionRatio="1:1"/>

  </androidx.constraintlayout.widget.ConstraintLayout>

  <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/keyboard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="@dimen/spacing"
    app:layout_constraintBottom_toTopOf="@id/buttons_holder">

    <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/top_keyboard_row"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      app:layout_constraintBottom_toTopOf="@id/middle_keyboard_row"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintWidth_percent="1">

      <TextView
        style="@style/keyboard_button"
        android:id="@+id/key_q"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/key_w"/>

      <TextView
        style="@style/keyboard_button"
        android:id="@+id/key_w"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/key_q"
        app:layout_constraintEnd_toStartOf="@id/key_e"/>

      <TextView
        style="@style/keyboard_button"
        android:id="@+id/key_e"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/key_w"
        app:layout_constraintEnd_toStartOf="@id/key_r"/>

      <TextView
        style="@style/keyboard_button"
        android:id="@+id/key_r"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/key_e"
        app:layout_constraintEnd_toStartOf="@id/key_t"/>

      <TextView
        style="@style/keyboard_button"
        android:id="@+id/key_t"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/key_r"
        app:layout_constraintEnd_toStartOf="@id/key_y"/>

      <TextView
        style="@style/keyboard_button"
        android:id="@+id/key_y"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/key_t"
        app:layout_constraintEnd_toStartOf="@id/key_u"/>

      <TextView
        style="@style/keyboard_button"
        android:id="@+id/key_u"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/key_y"
        app:layout_constraintEnd_toStartOf="@id/key_i"/>

      <TextView
        style="@style/keyboard_button"
        android:id="@+id/key_i"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/key_u"
        app:layout_constraintEnd_toStartOf="@id/key_o"/>

      <TextView
        style="@style/keyboard_button"
        android:id="@+id/key_o"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/key_i"
        app:layout_constraintEnd_toStartOf="@id/key_p"/>

      <TextView
        style="@style/keyboard_button"
        android:id="@+id/key_p"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/key_o"
        app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/middle_keyboard_row"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      app:layout_constraintBottom_toTopOf="@id/bottom_keyboard_row"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintWidth_percent="0.9">

      <TextView
        style="@style/keyboard_button"
        android:id="@+id/key_a"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/key_s"/>

      <TextView
        style="@style/keyboard_button"
        android:id="@+id/key_s"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/key_a"
        app:layout_constraintEnd_toStartOf="@id/key_d"/>

      <TextView
        style="@style/keyboard_button"
        android:id="@+id/key_d"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/key_s"
        app:layout_constraintEnd_toStartOf="@id/key_f"/>

      <TextView
        style="@style/keyboard_button"
        android:id="@+id/key_f"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/key_d"
        app:layout_constraintEnd_toStartOf="@id/key_g"/>

      <TextView
        style="@style/keyboard_button"
        android:id="@+id/key_g"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/key_f"
        app:layout_constraintEnd_toStartOf="@id/key_h"/>

      <TextView
        style="@style/keyboard_button"
        android:id="@+id/key_h"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/key_g"
        app:layout_constraintEnd_toStartOf="@id/key_j"/>

      <TextView
        style="@style/keyboard_button"
        android:id="@+id/key_j"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/key_h"
        app:layout_constraintEnd_toStartOf="@id/key_k"/>

      <TextView
        style="@style/keyboard_button"
        android:id="@+id/key_k"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/key_j"
        app:layout_constraintEnd_toStartOf="@id/key_l"/>

      <TextView
        style="@style/keyboard_button"
        android:id="@+id/key_l"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/key_k"
        app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/bottom_keyboard_row"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintWidth_percent="0.8">

      <TextView
        style="@style/keyboard_button"
        android:id="@+id/key_z"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/key_x"/>

      <TextView
        style="@style/keyboard_button"
        android:id="@+id/key_x"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/key_z"
        app:layout_constraintEnd_toStartOf="@id/key_c"/>

      <TextView
        style="@style/keyboard_button"
        android:id="@+id/key_c"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/key_x"
        app:layout_constraintEnd_toStartOf="@id/key_v"/>

      <TextView
        style="@style/keyboard_button"
        android:id="@+id/key_v"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/key_c"
        app:layout_constraintEnd_toStartOf="@id/key_b"/>

      <TextView
        style="@style/keyboard_button"
        android:id="@+id/key_b"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/key_v"
        app:layout_constraintEnd_toStartOf="@id/key_n"/>

      <TextView
        style="@style/keyboard_button"
        android:id="@+id/key_n"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/key_b"
        app:layout_constraintEnd_toStartOf="@id/key_m"/>

      <TextView
        style="@style/keyboard_button"
        android:id="@+id/key_m"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/key_n"
        app:layout_constraintEnd_toStartOf="@id/key_blank"/>

      <TextView
        android:id="@+id/key_blank"
        style="@style/keyboard_button"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/key_m"
        app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
      style="@style/keyboard_button"
      android:id="@+id/delete_letter"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:src="@drawable/ic_outline_backspace_24"
      android:contentDescription="Backspace"
      android:textColor="?colorButtonSubmitForeground"
      android:padding="@dimen/spacing"
      app:layout_constraintWidth_percent="0.2"
      app:tint="?colorKeyText"
      app:layout_constraintTop_toTopOf="@id/bottom_keyboard_row"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

  </androidx.constraintlayout.widget.ConstraintLayout>

  <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/buttons_holder"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:layout_constraintBottom_toBottomOf="parent"
    android:padding="@dimen/spacing">

    <ImageView
      android:id="@+id/show_hint"
      android:layout_width="wrap_content"
      android:layout_height="0dp"
      android:background="@drawable/button_background_get_hint"
      android:padding="@dimen/spacing"
      android:src="@drawable/ic_round_search_24"
      android:text="Get Hint"
      android:textColor="?colorButtonSubmitForeground"
      app:tint="?colorButtonForeground"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"/>

    <ImageView
      android:id="@+id/skip_next"
      android:layout_width="wrap_content"
      android:layout_height="0dp"
      android:background="@drawable/button_background_skip_next"
      android:gravity="center"
      android:padding="@dimen/spacing"
      android:src="@drawable/ic_round_skip_next_24"
      android:textColor="?colorButtonSubmitForeground"
      app:tint="?colorButtonForeground"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

    <TextView
      android:id="@+id/submit_button"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:background="@drawable/button_background_submit_disabled"
      android:gravity="center"
      android:text="Submit"
      android:textColor="?colorButtonSubmitForeground"
      android:textSize="@dimen/submit_text_size"
      android:textStyle="bold"
      app:layout_constraintBottom_toBottomOf="@id/show_hint"
      app:layout_constraintEnd_toStartOf="@id/skip_next"
      app:layout_constraintStart_toEndOf="@id/show_hint"
      app:layout_constraintTop_toTopOf="@id/show_hint" />

  </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
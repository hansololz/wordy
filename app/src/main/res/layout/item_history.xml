<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:paddingStart="@dimen/spacing"
  android:paddingTop="@dimen/spacing"
  android:paddingEnd="@dimen/spacing"
  android:paddingBottom="@dimen/spacing_none">

  <ImageView
    android:id="@+id/bookmark_button"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/button_background_search"
    android:padding="@dimen/spacing"
    android:src="@drawable/ic_round_bookmark_border_24"
    app:tint="?colorButtonSearchForeground"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent" />

  <ImageView
    android:id="@+id/search_button"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/button_background_search"
    android:padding="@dimen/spacing"
    android:src="@drawable/ic_round_search_24"
    android:layout_marginStart="@dimen/spacing"
    android:layout_marginEnd="@dimen/spacing_none"
    app:tint="?colorButtonSearchForeground"
    app:layout_constraintStart_toEndOf="@id/bookmark_button"
    app:layout_constraintTop_toTopOf="parent" />

  <TextView
    android:id="@+id/title"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/spacing"
    android:paddingEnd="@dimen/spacing"
    android:textColor="?colorLetterText"
    android:textSize="@dimen/letter_text_size"
    android:textStyle="bold"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toEndOf="@id/search_button"
    app:layout_constraintTop_toTopOf="parent" />

  <TextView
    android:id="@+id/context"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/spacing"
    android:paddingEnd="@dimen/spacing_none"
    android:textColor="?colorText"
    android:textSize="16sp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toEndOf="@id/search_button"
    app:layout_constraintTop_toBottomOf="@id/title"
    app:layout_constraintBottom_toBottomOf="@id/search_button"/>

  <TextView
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:layout_marginTop="@dimen/spacing"
    android:background="?colorDivider"
    app:layout_constraintTop_toBottomOf="@id/bookmark_button"
    app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
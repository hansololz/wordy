<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:paddingStart="@dimen/spacing_none"
  android:paddingTop="@dimen/spacing_none"
  android:paddingEnd="@dimen/spacing"
  android:paddingBottom="@dimen/spacing_none">

  <TextView
    android:id="@+id/divider"
    android:layout_width="match_parent"
    android:layout_height="1dp"
    android:background="?colorDivider"
    app:layout_constraintTop_toTopOf="parent" />

  <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/bookmark_button_holder"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/spacing"
    android:paddingTop="@dimen/spacing"
    android:paddingEnd="@dimen/spacing_half"
    android:paddingBottom="@dimen/spacing"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toBottomOf="@id/divider">

    <ImageView
      android:id="@+id/bookmark_button"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@drawable/button_background_round_info"
      android:padding="@dimen/spacing_half"
      android:src="@drawable/ic_round_bookmark_border_24"
      app:layout_constraintStart_toStartOf="parent"
      app:tint="?colorButtonForeground" />

  </androidx.constraintlayout.widget.ConstraintLayout>

  <androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/search_button_holder"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/spacing_half"
    android:paddingTop="@dimen/spacing"
    android:paddingEnd="@dimen/spacing"
    android:paddingBottom="@dimen/spacing"
    app:layout_constraintStart_toEndOf="@id/bookmark_button_holder"
    app:layout_constraintTop_toBottomOf="@id/divider">

    <ImageView
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_marginStart="@dimen/spacing"
      android:background="@drawable/button_background_round_info"
      android:padding="@dimen/spacing_half"
      android:src="@drawable/ic_round_search_24"
      app:tint="?colorButtonForeground" />

  </androidx.constraintlayout.widget.ConstraintLayout>

  <TextView
    android:id="@+id/title"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/spacing"
    android:paddingEnd="@dimen/spacing"
    android:textColor="?colorText"
    android:textSize="@dimen/header_text_size"
    android:textStyle="bold"
    app:layout_constraintBottom_toBottomOf="@id/search_button_holder"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toEndOf="@id/search_button_holder"
    app:layout_constraintTop_toBottomOf="@id/divider" />

</androidx.constraintlayout.widget.ConstraintLayout>
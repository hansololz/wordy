<?xml version="1.0" encoding="utf-8"?>
<resources>

  <style name="keyboard_row">
    <item name="android:layout_width">0dp</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:orientation">horizontal</item>
  </style>

  <style name="keyboard_button">
    <item name="android:layout_width">0dp</item>
    <item name="android:layout_height">52dp</item>
    <item name="android:gravity">center</item>
    <item name="android:background">@drawable/key_background_no_guess</item>
    <item name="android:textAllCaps">true</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textColor">?colorKeyNoGuess</item>
    <item name="android:textSize">@dimen/keyboard_text_size</item>
  </style>

  <style name="letters_row">
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:orientation">horizontal</item>
  </style>

  <style name="letters_slot">
    <item name="android:layout_width">0dp</item>
    <item name="android:layout_height">0dp</item>
    <item name="android:background">@drawable/letter_background_no_guess</item>
    <item name="android:gravity">center</item>
    <item name="android:textSize">@dimen/letter_text_size</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textColor">?colorLetterText</item>
    <item name="android:textAllCaps">true</item>
  </style>

</resources>